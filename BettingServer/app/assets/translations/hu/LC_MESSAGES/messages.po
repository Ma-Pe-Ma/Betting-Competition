msgid "Error while initializing the teams!"
msgstr "Hiba a csapatok inicializálása közben!"

#: app/admin.py:263
msgid "Error while initializing the matches!"
msgstr "Hiba a meccsek inicializálása közben!"

#: app/admin.py:265
msgid "Team data file uploading was successful!"
msgstr "Csapatleíró fájlok feltöltése sikeres volt!"

#: app/admin.py:284
msgid "Database file was not specified!"
msgstr "Az adatbázis fájl nem lett megadva!"

#: app/admin.py:289
msgid "Database file is null!"
msgstr "Az adatbázis fájl nem létezik!"

#: app/admin.py:298
msgid "Database file uploading was successful!"
msgstr "Az adatbázis fájl feltöltése sikeres volt!"

#: app/admin.py:301
msgid "Error while saving new database file!"
msgstr "Hiba az új adatbázisfájl lementése közben!"

#: app/admin.py:303
msgid "The specified format cannot be uploaded!"
msgstr "A megadott formátum nem tölthető fel!"

