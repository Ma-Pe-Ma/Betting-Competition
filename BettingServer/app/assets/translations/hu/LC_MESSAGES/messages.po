msgid "Tournament bet results set successfully!"
msgstr "Tornatipp-eredmények sikeresen megadva!"

#: app/admin.py:232
msgid "One of the files was not specified for the request!"
msgstr "Az egyik fájl nem lett megadva a kéréshez!"

#: app/admin.py:238
msgid "No team file was specified!"
msgstr "A csapatleíró fájl nem lett megadva!"

#: app/admin.py:242
msgid "No translation file was specified!"
msgstr "A csapatnév-fordítás tartalmazó fájl nem lett megadva!"

#: app/admin.py:245
msgid "The uploaded file's extension is not correct!"
msgstr "Feltöltendő fájl kiterjesztése nem megfelelő!"

