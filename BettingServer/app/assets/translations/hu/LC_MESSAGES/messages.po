msgstr "404-es oldal"

#: app/templates/error-handling/page-404.html:10
msgid "The page cannot be found!"
msgstr "Az oldal nem található."

#: app/templates/error-handling/page-404.html:11
msgid "You are probably at the wrong place."
msgstr "Valószínűleg rossz helyen vagy."

#: app/templates/error-handling/page-404.html:12
#: app/templates/error-handling/page-500.html:12
msgid "Homepage"
msgstr "Kezdőoldal"

#: app/templates/error-handling/page-500.html:3
