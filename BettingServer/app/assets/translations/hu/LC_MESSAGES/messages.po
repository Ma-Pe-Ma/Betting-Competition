msgstr "Nem létezik meccs a következő azonosítóval: %(id)s!"

#: app/match_bet.py:43
#, python-format
msgid "Match %(id)s has already started!"
msgstr "Meccs %(id)s már elkezdődött!"

#: app/match_bet.py:56
msgid "Invalid input for goal or credit!"
msgstr "Érvénytelen gól vagy kredit érték!"

#: app/match_bet.py:59
